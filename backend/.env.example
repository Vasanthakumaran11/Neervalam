# Supabase Project Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# JWT & Security
JWT_SECRET=your-custom-jwt-secret-or-supabase-jwt-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OTP & SMS Gateway Settings
# Options: 'supabase' (uses configured Twilio/MessageBird in Supabase) or 'mock_dev' (prints OTP in console, accepts 123456)
OTP_MODE=mock_dev

# Allowed Frontend Origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
