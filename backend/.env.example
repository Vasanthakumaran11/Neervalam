# Supabase Project Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# JWT & Security
JWT_SECRET=your-custom-jwt-secret-or-supabase-jwt-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OTP & SMS Gateway Settings
# Options: 'supabase' (uses configured Twilio/MessageBird in Supabase) or 'mock_dev' (prints OTP in console, accepts 123456)
OTP_MODE=mock_dev

# Allowed Frontend Origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ==============================================================================
# Real Email OTP Configuration (SMTP)
# ==============================================================================
# Works with Gmail (App Password), Outlook, Brevo, SendGrid, or any standard SMTP:
# For Gmail:
#   1. Google Account -> Security -> 2-Step Verification
#   2. Generate an "App Password" (16 characters)
#   3. Fill SMTP_USER and SMTP_PASSWORD below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Neervalam Water Portal
SMTP_USE_TLS=true
